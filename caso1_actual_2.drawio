        <mxCell id="a_l2" value="2) Envia BLOCK manual por Subscriber ID en legado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="560" width="420" height="60" as="geometry"/>
