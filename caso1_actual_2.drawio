        <mxCell id="a_net" value="Sistema de Red (Network Core)&#xa;Linux propietario (HPE ProLiant)&#xa;Recibe comandos via sistema legado&#xa;Cola interna + PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
