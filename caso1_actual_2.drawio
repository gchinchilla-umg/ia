          <mxGeometry x="700" y="640" width="650" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a_pol" value="Politica vigente:&#xa;- Bloqueo al dia siguiente del vencimiento si no hay pago total&#xa;- Pago parcial NO reactiva&#xa;- Si hay multiples facturas, debe cubrir deuda total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
